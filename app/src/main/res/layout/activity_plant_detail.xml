<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F4"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/room_card_bg"
            android:padding="20dp">

            <TextView
                android:id="@+id/textPlantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monstera"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1E2A1F"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textPlantRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raum: Wohnzimmer"
                android:textSize="16sp"
                android:textColor="#6E7B6F"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#223322"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textTemperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temperatur: 22°C"
                android:textSize="16sp"
                android:textColor="#223322"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textMoisture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feuchtigkeit: 45%"
                android:textSize="16sp"
                android:textColor="#223322"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textLastWatered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zuletzt gegossen: 02.04.2026"
                android:textSize="16sp"
                android:textColor="#223322"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/buttonWaterNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jetzt gießen"
                android:textAllCaps="false"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pflegehinweise"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#223322"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textCareHints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hell stellen, aber keine direkte Mittagssonne."
                android:textSize="16sp"
                android:textColor="#223322"
                android:background="@drawable/plant_item_bg"
                android:padding="16dp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nach links wischen zum Schließen"
                android:textSize="14sp"
                android:textColor="#7A857B"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>